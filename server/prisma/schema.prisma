// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider               = "prisma-client"
    output                 = "../../shared/prisma"
    previewFeatures        = ["typedSql"]
    generatedFileExtension = "ts"
    importFileExtension    = "ts"
    moduleFormat           = "esm"
}

generator zod {
    provider         = "prisma-zod-generator"
    output           = "../../shared/zod"
    prismaClientPath = "../../shared/prisma"
}

datasource db {
    provider = "postgresql"
}

// ------------------------ Enums ---------------------------

enum LogAction {
    TRANSACTION_CREATE
    TRANSACTION_EDIT
    TRANSACTION_DELETE
    SUBMIT_ESS
    TAG_ESS_REJECT
    TAG_ESS_REVISION
    TAG_ESS_APPROVE
    USER_ADD
    USER_RESET_PASSWORD
    USER_EDIT
    USER_PROMOTE
    USER_DEMOTE
    REPORTS_DOWNLOAD_DAILY
    REPORTS_DOWNLOAD_WEEKLY
    REPORTS_DOWNLOAD_MONTHLY
    REPORTS_DOWNLOAD_OVERALL
}

enum Status {
    ONLINE
    OFFLINE
    LOGGED_OUT
    DISABLED
}

enum Sex {
    MALE
    FEMALE
}

enum Role {
    SUPERADMIN
    ADMIN
    FRONTLINE
}

enum Shift {
    MORNING
    AFTERNOON
    NONE
}

enum TransactionType {
    WALK_IN_REFERRAL
    ONLINE_REFERRAL
    IN_HOUSE_RECRUITMENT
}

enum Outcome {
    PENDING
    MISMATCH
    SUCCESS
    NONE
}

enum ESSStatus {
    PENDING
    REJECTED
    REVISION
    APPROVED
    ONGOING
}

enum Demographic {
    FIRST_TIME_JOB_SEEKER
    PERSONS_WITH_DISABILITY
    SENIOR_CITIZEN
    YOUNG_WORKER
    WORK_IMMERSION_INTERNSHIP
}

enum EnvironmentTag {
    SLOW_INTERNET
    HEAVY_RAIN
    BROKEN_EQUIPMENT
    APPLICANT_ISSUES
    FEELING_UNWELL
    BROKEN_SOFTWARE_SYSTEM
}

// ------------------------ Models ---------------------------

model Transaction {
    id Int @id @default(autoincrement())

    /// @zod.string.min(1, { message: "Shift Log Id cannot be empty" }).max(256)
    user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
    userId Int?

    /// @zod.string.min(1, { message: "Shift Log Id cannot be empty" }).max(256)
    shiftLog   ShiftLog? @relation(fields: [shiftLogId], references: [id], onDelete: SetNull)
    shiftLogId Int?

    /// @zod.trim().min(1, "Application last name cannot be empty")
    applicantFirstName String @db.VarChar(256)

    /// @zod.trim().min(1, "Application last name cannot be empty")
    applicantLastName String @db.VarChar(256)

    // Para mag span yung search sa full name string
    applicantFullName String? @default(dbgenerated()) @db.VarChar(256)

    applicantSex       Sex
    transactionOutcome Outcome         @default(NONE)
    createdAt          DateTime        @default(now()) @db.Timestamptz(0)
    transactionType    TransactionType @default(WALK_IN_REFERRAL)
    remarks            String?
    demographics       Demographic[]
    txCode             String          @unique
    updatedAt          DateTime        @default(now()) @db.Timestamptz(0)

    @@index([applicantFullName])
    @@index([userId, createdAt(sort: Desc)])
    @@index([shiftLogId, createdAt(sort: Desc)])
    @@index([createdAt])
}

model ShiftLog {
    id Int @id @default(autoincrement())

    userId Int?
    user   User? @relation("UserShiftLogs", fields: [userId], references: [id], onDelete: SetNull)

    verifierId Int?
    verifier   User? @relation("VerifiedShiftLogs", fields: [verifierId], references: [id], onDelete: SetNull)

    // Sa unang insert timeIn palang yung pwede mailagay
    timeIn          DateTime         @default(now()) @db.Timestamptz(0)
    timeOut         DateTime?        @db.Timestamptz(0)
    status          ESSStatus        @default(ONGOING) // Meron pa ring status
    generalRemarks  String?
    adminRemarks    String?
    lastVerifiedAt  DateTime?        @db.Timestamptz(0)
    environmentTags EnvironmentTag[]
    transactions    Transaction[]

    @@index([userId])
    @@index([status])
    @@index([verifierId])
}

model User {
    id Int @id @default(autoincrement())

    /// @zod.string()
    username String @unique @db.VarChar(256)

    /// @zod.string()
    password String @db.VarChar(256)

    /// @zod.string.min(1, { message: "Email cannot be empty" }).max(256)
    email String @unique @db.VarChar(256)

    role   Role   @default(FRONTLINE)
    status Status @default(LOGGED_OUT)
    shift  Shift  @default(NONE)

    /// @zod.string.min(1, { message: "First Name cannot be empty" }).max(256)
    firstName String @db.VarChar(256)

    /// @zod.string.min(1, { message: "Last Name cannot be empty" }).max(256)
    lastName String @db.VarChar(256)

    createdAt         DateTime      @default(now()) @db.Timestamptz(0)
    updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(0)
    fullName          String?       @default(dbgenerated()) @db.VarChar(256)
    accountLogs       AccountLog[]
    auditLogs         AuditLog[]
    shiftLogs         ShiftLog[]    @relation("UserShiftLogs")
    verifiedShiftLogs ShiftLog[]    @relation("VerifiedShiftLogs")
    transactions      Transaction[]

    resetToken          String?   @unique
    resetTokenExpiresAt DateTime?

    // check if user is currently revising a shift
    isRevising Boolean @default(false)

    @@index([fullName])
    @@index([role, status])
    @@index([createdAt(sort: Desc)])
}

model AuditLog {
    id Int @id @default(autoincrement())

    userId Int?
    user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    createdAt        DateTime  @default(now()) @db.Timestamptz(0)
    actionPerformed  LogAction
    affectedRecordId Int
    changesDetails   String

    @@index([userId, createdAt(sort: Desc)])
}

model AccountLog {
    id Int @id @default(autoincrement())

    userId Int?
    user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    // Sa unang insert logIn palang yung pwede mailagay
    logIn   DateTime  @default(now()) @db.Timestamptz(0)
    logOut  DateTime? @db.Timestamptz(0)
    reason  String?
    remarks String?

    @@index([userId, logIn(sort: Desc)])
}
